{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/about.json: el sobre mí",
  "description": "data/about.json: el título, el texto y el contacto. VS Code lee este fichero (por el \"$schema\" de arriba del JSON) para autocompletar, explicar cada campo y subrayar lo que está mal; el build y la vista previa lo usan para revisar.",
  "type": "object",
  "required": [
    "title",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_": {
      "type": "string"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ca"
      ],
      "description": "El título: { \"ca\": \"sobre mi\", \"es\": \"sobre mí\", \"en\": \"about me\" }",
      "properties": {
        "ca": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ca"
      ],
      "description": "El texto, una lista de párrafos por idioma.",
      "properties": {
        "ca": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "es": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contact": {
      "type": "array",
      "description": "Las líneas de contacto: { \"text\": \"@paulabarjau\", \"url\": \"https://…\" }",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "\"https://…\" o \"mailto:…\""
          }
        }
      }
    }
  }
}
