{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "projects/<nombre>/project.json: un proyecto",
  "description": "projects/<nombre>/project.json: un proyecto. Sus imágenes, en img/ de la misma carpeta, con su nombre. VS Code lee este fichero (por el \"$schema\" de arriba del JSON) para autocompletar, explicar cada campo y subrayar lo que está mal; el build y la vista previa lo usan para revisar.",
  "type": "object",
  "required": [
    "title",
    "category",
    "date",
    "cover",
    "summary",
    "main",
    "photos"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "El título del proyecto."
    },
    "category": {
      "type": "string",
      "description": "La categoría: una de data/site.json → categories (\"fashion\", \"commercial\", \"videoclip\", \"editorial\")."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "AAAA-MM-DD. Con la misma relevancia, sale antes el más nuevo."
    },
    "relevance": {
      "type": "number",
      "minimum": 0,
      "description": "El orden en la portada: 1 sale antes que 2, sin comillas."
    },
    "cover": {
      "type": "string",
      "description": "La imagen de la portada, de img/: \"aitanaBonmati_1.webp\""
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ca"
      ],
      "description": "Lo que sale encima de la imagen en la portada, en los tres idiomas.",
      "properties": {
        "ca": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "main": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "youtube"
          ],
          "additionalProperties": false,
          "properties": {
            "youtube": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        }
      ],
      "description": "Lo de arriba del proyecto: una imagen de img/ (\"foto_1.webp\") o un vídeo de YouTube: { \"youtube\": [\"https://www.youtube.com/watch?v=…\"] }"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Las fotos de la galería, de img/, en orden: [\"foto_1.webp\", \"foto_2.webp\"]"
    },
    "credits": {
      "type": "array",
      "description": "Los créditos, una persona por línea con su rol en los tres idiomas: { \"role\": { \"ca\": …, \"es\": …, \"en\": … }, \"name\": \"…\", \"url\": \"https://…\" }. O una línea de texto: { \"text\": { \"ca\": …, \"es\": …, \"en\": … } }",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "role",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ca"
                ],
                "description": "El rol, en los tres idiomas.",
                "properties": {
                  "ca": {
                    "type": "string"
                  },
                  "es": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "description": "Opcional: un enlace (su instagram, su web)."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ca"
                ],
                "description": "Una línea de texto, en los tres idiomas.",
                "properties": {
                  "ca": {
                    "type": "string"
                  },
                  "es": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              },
              "kind": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
